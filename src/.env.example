# --- Kötelező ---
ODDS_API_KEY=ide_az_odds_api_kulcs
DATABASE_URL=postgresql://postgres:jelszo@db.xxxxx.supabase.co:5432/postgres

# --- Telegram (ha üres, csak a konzolra ír) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mit figyeljen ---
# The Odds API sport kulcsok (vesszővel). Lista: GET /v4/sports
SPORTS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,basketball_euroleague,basketball_nba,icehockey_nhl
MARKETS=h2h,totals,spreads
SHARP_BOOK=pinnacle
SOFT_BOOKS=onexbet,marathonbet

# --- Szűrők ---
MIN_EDGE=0.02            # min. 2% előny
MAX_EDGE=0.10            # 10% felett gyanús (hibás/elavult vonal) -> nem jelez
MIN_MINUTES_TO_START=10  # ennél közelebb a kezdéshez nem jelez
LOOKAHEAD_HOURS=12       # csak az ennyi órán belül kezdődő meccseket kéri le
MAX_STALENESS_SEC=300    # ennél régebbi odds nem számít
MAX_ODDS=5.0
MIN_ODDS=1.30
DEVIG_METHOD=power       # power | multiplicative

# --- Ütemezés / kvóta ---
SCAN_INTERVAL_MIN=5
SETTLE_INTERVAL_MIN=60
MIN_QUOTA_REMAINING=200  # ennyi kredit alatt leáll a szkennelés
DAILY_CREDIT_BUDGET=0    # napi kreditkeret (budapesti nap szerint), 0 = nincs korlát
