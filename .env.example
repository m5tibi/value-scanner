# --- Kötelező ---
ODDS_API_KEY=ide_az_odds_api_kulcs
DATABASE_URL=postgresql://postgres:jelszo@db.xxxxx.supabase.co:5432/postgres

# --- Telegram (ha üres, csak a konzolra ír) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mit figyeljen ---
# The Odds API sport kulcsok (vesszővel). Lista: GET /v4/sports
SPORTS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,basketball_euroleague,basketball_nba,icehockey_nhl
MARKETS=h2h,totals,spreads
SHARP_BOOK=pinnacle
SOFT_BOOKS=onexbet,marathonbet

# --- Szűrők ---
# min. 2% előny
MIN_EDGE=0.02
# 10% felett gyanús (hibás/elavult vonal) -> nem jelez
MAX_EDGE=0.10
# ennél közelebb a kezdéshez nem jelez
MIN_MINUTES_TO_START=10
# csak az ennyi órán belül kezdődő meccseket kéri le
LOOKAHEAD_HOURS=12
# ennél régebbi odds nem számít
MAX_STALENESS_SEC=300
MAX_ODDS=5.0
MIN_ODDS=1.30
# power | multiplicative
DEVIG_METHOD=power

# --- Ütemezés / kvóta ---
SCAN_INTERVAL_MIN=5
SETTLE_INTERVAL_MIN=60
# ennyi kredit alatt leáll a szkennelés
MIN_QUOTA_REMAINING=200
# napi kreditkeret (budapesti nap szerint), 0 = nincs korlát
DAILY_CREDIT_BUDGET=0

# --- Követő értesítések (szkenner) ---
# 🔔 újra szól, ha ugyanarra a kimenetelre jobb az odds ÉS az előny legalább ennyivel nőtt
IMPROVE_MIN_DELTA=0.02
# kimenetelenként legfeljebb ennyi 🔔
IMPROVE_MAX=2

# --- Sportfolio-figyelő (saját gépen: npm run sf:listen) ---
# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# npm run sf:login után kapod (titkos! olyan, mint egy jelszó a fiókodhoz)
TG_SESSION=
# A figyelt csatornák vesszővel: ID (npm run sf:channels) vagy a név egy része.
# Az ID biztosabb: a csatornákat időnként átnevezik.
# Formátumot magától felismeri: surebet (Value NonStop) vagy OddsHub (Tippmix Value, TPro Value).
SPORTFOLIO_CHANNELS=Value NonStop,TPro Value,Tippmix Value
# mehet | ovatosan | kihagy (= minden)
SF_NOTIFY_LEVEL=ovatosan
SF_MIN_EDGE=0.02
SF_MAX_EDGE=0.10
SF_MIN_MINUTES=5
# Tét egységben: 1 egység = a bankroll ennyi %-a
SF_UNIT_PCT=1
# a teljes Kelly ekkora része (0.25 = negyed-Kelly)
SF_KELLY_FRACTION=0.25
# egy fogadásra legfeljebb ennyi egység
SF_MAX_UNITS=3
# e fölött "nagyon nagy eltérés": nem hagyja ki, de a tétet korlátozza
SF_HUGE_EDGE=0.20
SF_HUGE_MAX_UNITS=1
# 🔔 ugyanígy a Sportfolio-jelzésekre (ismétlést csak javulásnál küld újra)
SF_IMPROVE_DELTA=0.02
SF_IMPROVE_MAX=2
