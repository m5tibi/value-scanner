{
  "name": "value-scanner",
  "version": "0.8.0",
  "description": "Pinnacle-alapú value-szkenner papíros CLV-naplózással (The Odds API + PostgreSQL + Telegram)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/index.js",
    "scan:once": "node src/index.js --once",
    "tick": "node src/index.js --tick",
    "settle": "node src/index.js --settle",
    "report": "node src/index.js --report",
    "migrate": "node src/index.js --migrate",
    "test": "node --test test/*.test.js",
    "sf:login": "node --env-file=.env src/sportfolio/listener.js --login",
    "sf:channels": "node --env-file=.env src/sportfolio/listener.js --channels",
    "sf:backfill": "node --env-file=.env src/sportfolio/listener.js --backfill 50",
    "sf:listen": "node --env-file=.env src/sportfolio/listener.js"
  },
  "dependencies": {
    "pg": "^8.11.0",
    "telegram": "^2.26.22"
  }
}
